# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Payload DB schema auto-push (recommended false on shared DB)
# Set true only if you intentionally want Payload to auto-mutate schema in development
PAYLOAD_DB_PUSH=false

# Toggle custom Payload admin UI components (dashboard, reports, custom nav)
# Set false to fallback to default Payload admin when troubleshooting blank admin panels
PAYLOAD_ENABLE_CUSTOM_ADMIN=true

# Payload log level: trace | debug | info | warn | error | fatal (default: info)
# Pesan "File ... is missing on the disk" sengaja diturunkan ke `debug` agar tidak
# membanjiri log sebagai ERROR. Set `debug` untuk memunculkannya kembali saat
# menelusuri gambar yang hilang.
PAYLOAD_LOG_LEVEL=info

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Open API reports (external access) - whitelist by domain + token
# Format JSON array:
# [
#   {"domain":"https://app-partner.example.com","tokens":["token-app-1","token-app-2"]},
#   {"domain":"https://bi-partner.example.com","token":"token-bi-1"}
# ]
REPORTS_OPEN_API_WHITELIST=[]

# Registration pipeline toggle
# Set true to bypass Google Sheets append (useful when testing Pixel/CAPI only).
# Local testing recommendation: true
# Production recommendation: false
REGISTRATION_BYPASS_GOOGLE_SHEETS=false

# Google Sheets (Registration Leads)
GOOGLE_SHEETS_SPREADSHEET_ID_JABODETABEK=your-jabodetabek-spreadsheet-id
GOOGLE_SHEETS_SPREADSHEET_ID_BANDUNG=your-bandung-spreadsheet-id
GOOGLE_SHEETS_SPREADSHEET_ID_DEFAULT=your-default-spreadsheet-id
GOOGLE_SHEETS_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=private/secrets/credentials.json


# Registration Meta CAPI debug toggle
# Set true to print success/failure + response payload to server logs
# and include it in API response JSON (for local testing only).
# Local testing recommendation: true
# Production recommendation: false
REGISTRATION_META_DEBUG=false

# Legacy fallback (opsional, untuk backward compatibility):
# REPORTS_OPEN_API_KEY=YOUR_REPORTS_OPEN_API_KEY
# REPORTS_OPEN_API_ALLOWED_ORIGINS=https://app-partner.example.com,https://another.example.com

# Facebook Pixel (client-side)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# TikTok Pixel (client-side). Leave empty to disable safely.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Meta Conversions API (server-side)
# Leave empty to disable server-side tracking safely.
FACEBOOK_PIXEL_ID=
FACEBOOK_CONVERSIONS_API_ACCESS_TOKEN=your-facebook-conversions-api-access-token

# Optional overrides
# FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_CONVERSIONS_TEST_EVENT_CODE=TEST1601

# Fleet Management System lead API (external partner integration)
# sendLeadToExternalApi() in src/services/googleSheets/appendLead.ts posts each
# registration lead here. Failures are caught and logged, not fatal to registration.
MOBIS_LEAD_API_URL=https://api.fleet-management-system.co.id/public/mobis/leads
MOBIS_LEAD_API_PUBLIC_KEY=YOUR_LEAD_API_PUBLIC_KEY_HERE
